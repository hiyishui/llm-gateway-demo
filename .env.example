# ============================================================
# LLM Gateway Demo 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 忽略，真实密钥只放在 .env 中，切勿提交
# ============================================================

# ---- 网关监听地址 ----
HOST=127.0.0.1
PORT=8000

# ---- 模型后端 ----
# mock：内置离线模拟服务，无需 API Key，适合学习与测试
# openai：任意 OpenAI 兼容的 Chat Completions 服务
LLM_PROVIDER=mock
# OpenAI: https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# 通义千问兼容模式: https://dashscope.aliyuncs.com/compatible-mode/v1
# 本地 Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# 输出上限字段名：多数兼容服务用 max_tokens；OpenAI 推理模型需用 max_completion_tokens
LLM_MAX_TOKENS_PARAM=max_tokens
LLM_MAX_OUTPUT_TOKENS=800
# 结构化输出模式：json_schema（服务端按 Schema 约束）/ json_object（只保证是 JSON）/ prompt（仅靠提示词）
# 不支持 json_schema 的服务（如部分国产模型、旧版 Ollama）请改为 json_object 或 prompt
LLM_STRUCTURED_OUTPUT_MODE=json_schema
# 流式时是否请求返回 usage（stream_options.include_usage），服务不支持时设为 false
LLM_STREAM_INCLUDE_USAGE=true

# ---- 超时与重试 ----
LLM_CONNECT_TIMEOUT=5
LLM_READ_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=0.5
LLM_RETRY_MAX_DELAY=8

# ---- 上下文与会话 ----
# 模型上下文上限（Token），按所选模型填写；示例值故意偏小，便于观察裁剪与摘要
CONTEXT_MAX_TOKENS=8000
# 触发压缩时保留的最近消息条数（滑动窗口）
HISTORY_KEEP_RECENT=6
SESSION_TTL_SECONDS=1800
# 单条输入的字符上限，超过直接返回 413
MAX_INPUT_CHARS=8000

# ---- Tool Calling 预算 ----
TOOL_MAX_ROUNDS=4
TOOL_TIMEOUT_SECONDS=5
TOOL_TOTAL_TIMEOUT_SECONDS=30
TOOL_RESULT_MAX_CHARS=2000

# ---- 网关自身认证：令牌:用户ID，逗号分隔 ----
# 客户端只持有这些网关令牌，永远接触不到 LLM_API_KEY
GATEWAY_TOKENS=demo-token-alice:alice,demo-token-bob:bob

# ---- 成本估算（美元 / 百万 Token），按所选模型的官方价格填写 ----
PRICE_INPUT_PER_1M=0.15
PRICE_OUTPUT_PER_1M=0.60

LOG_LEVEL=INFO
